extends SceneTree
## Screenshots of the NEW read-only Web observer with a fake PUBLIC fixture.
## The fixture is not DeepSeek and is not generated by a resident model.
func _initialize() -> void:
    call_deferred("_run_capture")

func _capture(view, requested: Vector2i, dusk: bool, file_name: String) -> bool:
    root.content_scale_mode = Window.CONTENT_SCALE_MODE_DISABLED
    root.size = requested
    DisplayServer.window_set_size(requested)
    view._set_time(dusk)
    await process_frame
    await process_frame
    await process_frame
    await RenderingServer.frame_post_draw
    var picture: Image = root.get_texture().get_image()
    var path: String = ProjectSettings.globalize_path("res://" + file_name)
    var code: Error = picture.save_png(path)
    print("PUBLIC_CAPTURE ", file_name, " viewport=", root.size, " image=", picture.get_size(), " result=", code)
    return code == OK and picture.get_size() == requested

func _run_capture() -> void:
    var view = load("res://scenes/public_viewer.tscn").instantiate()
    root.add_child(view)
    await process_frame
    var source = FileAccess.open("res://tests/fixtures/public_world_v2.json", FileAccess.READ)
    if source == null:
        printerr("PUBLIC_CAPTURE_FAIL: no fixture")
        quit(1)
        return
    var packet = JSON.parse_string(source.get_as_text())
    if typeof(packet) != TYPE_DICTIONARY or not view.apply_public_snapshot(packet):
        printerr("PUBLIC_CAPTURE_FAIL: invalid public fixture")
        quit(1)
        return
    var ok := true
    ok = await _capture(view, Vector2i(960, 600), false, "preview-public-observer-desktop.png") and ok
    ok = await _capture(view, Vector2i(853, 384), false, "preview-public-observer-landscape.png") and ok
    ok = await _capture(view, Vector2i(390, 844), true, "preview-public-observer-portrait.png") and ok
    quit(0 if ok else 1)
