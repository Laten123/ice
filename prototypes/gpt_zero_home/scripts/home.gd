extends Control
## Independent three-quarter-view home. Both touch and desktop input are first-class.
## The portrait layout becomes a draggable scenic panorama instead of squashing art.

const DAY_SCENE: Texture2D = preload("res://art/home_day.svg")
const DUSK_SCENE: Texture2D = preload("res://art/home_dusk.svg")
const ART_SIZE := Vector2(960.0, 600.0)
const WalkGraph = preload("res://scripts/world_graph.gd")
const ResidentActor = preload("res://scripts/resident_actor.gd")
const ScriptedIntentReplay = preload("res://scripts/demo_intents.gd")
const IntentGateway = preload("res://scripts/intent_gateway.gd")
const WorldObservation = preload("res://scripts/world_observation.gd")
const PixelGround = preload("res://scripts/pixel_ground.gd")
const MOBILE_LAYOUT_WIDTH := 540.0

var is_dusk := false
var scenery: TextureRect
var terrain: TextureRect
var terrain_day: Texture2D
var terrain_dusk: Texture2D
var day_button: Button
var dusk_button: Button
var status_label: Label
var hint_label: Label
var title_panel: PanelContainer
var title_label: Label
var subtitle_label: Label
var controls: HBoxContainer
var pan_x := 0.0
var is_portrait := false
var scene_width := 960.0
var resident_layer: Node2D
var residents: Dictionary = {}
var walk_graph
var scripted_replay: Node
var accepted_events: int = 0
var gateway
var demo_sequence: int = 0
var public_event_log: Array[Dictionary] = []
var observations
var resident_status_label: Label

func _ready() -> void:
    mouse_filter = Control.MOUSE_FILTER_STOP
    clip_contents = true
    _build_scenery()
    _build_residents()
    _build_ui()
    _set_time(false)
    _refresh_public_status()
    resized.connect(_refresh_layout)
    get_viewport().size_changed.connect(_refresh_layout)
    _refresh_layout()

func _build_scenery() -> void:
    # The old resident-action sandbox shares the same exterior textures;
    # it needs the SAME ground underlay after the SVG base was made clear.
    terrain_day = PixelGround.create_texture(false)
    terrain_dusk = PixelGround.create_texture(true)
    terrain = TextureRect.new()
    terrain.name = "PixelTerrainV1"
    terrain.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
    terrain.stretch_mode = TextureRect.STRETCH_SCALE
    terrain.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
    terrain.mouse_filter = Control.MOUSE_FILTER_IGNORE
    terrain.texture = terrain_day
    add_child(terrain)
    scenery = TextureRect.new()
    scenery.name = "OriginalSceneArtwork"
    scenery.set_anchors_and_offsets_preset(Control.PRESET_TOP_LEFT)
    scenery.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
    scenery.stretch_mode = TextureRect.STRETCH_SCALE
    scenery.mouse_filter = Control.MOUSE_FILTER_IGNORE
    add_child(scenery)

func _build_residents() -> void:
    walk_graph = WalkGraph.new()
    resident_layer = Node2D.new()
    resident_layer.name = "ResidentLayer"
    add_child(resident_layer)

    # Temporary handmade sprites. Their decisions are NOT generated by this
    # viewer. Only the test adapter can emit events for now.
    var people := [
        {
            "uuid": "00000000-0000-4000-8000-000000000001",
            "label": "深寻",
            "color": Color("#74859a"),
            "hair": Color("#53607b"),
            "start": "book_corner"
        },
        {
            "uuid": "00000000-0000-4000-8000-000000000002",
            "label": "小冰",
            "color": Color("#d6c1d2"),
            "hair": Color("#aecbd1"),
            "start": "porch"
        }
    ]
    for info in people:
        var actor = ResidentActor.new()
        actor.configure(info["uuid"], info["label"], info["color"], info["hair"], info["start"], walk_graph)
        actor.state_changed.connect(_on_resident_state)
        resident_layer.add_child(actor)
        residents[info["uuid"]] = actor

    gateway = IntentGateway.new()
    gateway.configure(residents)
    observations = WorldObservation.new()
    observations.configure(residents, walk_graph)
    gateway.public_receipt.connect(_on_public_receipt)

    # Test-only intent replay. This explicitly is NOT autonomous AI.
    scripted_replay = ScriptedIntentReplay.new()
    # Test fixtures must never silently imitate live AI. Opt in explicitly.
    scripted_replay.playback_enabled = OS.get_cmdline_user_args().has("--demo-intents")
    scripted_replay.name = "ScriptedIntentReplay"
    scripted_replay.scripted_intent.connect(_on_scripted_intent)
    add_child(scripted_replay)

func _on_scripted_intent(uuid: String, intent: Dictionary) -> void:
    # The scene has no owner controls or public network intake for movement.
    # A future authenticated server adapter must be built separately.
    demo_sequence += 1
    # This stand-in identity exists ONLY in the offline test fixture. A real
    # client must not supply its own verified_resident_id or bypass authentication.
    var message := {
        "event_id": "scripted-event-" + str(demo_sequence),
        "resident_id": uuid,
        "action": str(intent.get("action", ""))
    }
    if intent.has("target"):
        message["target"] = intent["target"]
    var result: Dictionary = gateway.dispatch_verified(message, uuid)
    if result["status"] == "accepted":
        accepted_events += 1
    print("RESIDENT_EVENT [scripted-demo ONLY] ", uuid, " ", result["status"])

func _on_resident_state(uuid: String, state_name: String) -> void:
    print("RESIDENT_STATE ", uuid, " ", state_name)
    _refresh_public_status()

func _refresh_public_status() -> void:
    if observations == null or resident_status_label == null:
        return
    var output := PackedStringArray()
    for person in observations.public_snapshot()["residents"]:
        var action: String = str(person["activity"])
        var readable: String = {
            "move": "散步中", "stay": "停留", "read": "阅读",
            "sit": "坐着", "rest": "休息", "decline": "谢绝活动"
        }.get(action, action)
        output.append(str(person["name"]) + " · " + readable)
    resident_status_label.text = "\n".join(output) + "\n（公开的演示状态，不含私人记忆）"

func public_snapshot() -> Dictionary:
    return observations.public_snapshot()

func observation_for_verified_resident(verified_resident_id: String) -> Dictionary:
    return observations.observation_for_verified_resident(verified_resident_id)

func _on_public_receipt(data: Dictionary) -> void:
    public_event_log.append(data.duplicate())
    _refresh_public_status()
    if public_event_log.size() > 40:
        public_event_log.pop_front()
    print("PUBLIC_RECEIPT ", JSON.stringify(data))

func _panel_style() -> StyleBoxFlat:
    var style := StyleBoxFlat.new()
    style.bg_color = Color(0.13, 0.19, 0.18, 0.86)
    style.set_corner_radius_all(12)
    style.content_margin_left = 14
    style.content_margin_top = 9
    style.content_margin_right = 14
    style.content_margin_bottom = 9
    return style

func _make_time_button(node_name: String, label_text: String, dusk: bool) -> Button:
    var result := Button.new()
    result.name = node_name
    result.text = label_text
    result.focus_mode = Control.FOCUS_NONE
    result.toggle_mode = true
    result.mouse_filter = Control.MOUSE_FILTER_STOP
    result.pressed.connect(func(): _set_time(dusk))
    result.add_theme_font_size_override("font_size", 18)
    return result

func _build_ui() -> void:
    title_panel = PanelContainer.new()
    title_panel.name = "TitlePanel"
    title_panel.set_anchors_and_offsets_preset(Control.PRESET_TOP_LEFT)
    title_panel.add_theme_stylebox_override("panel", _panel_style())
    add_child(title_panel)

    var header := VBoxContainer.new()
    title_panel.add_child(header)
    title_label = Label.new()
    title_label.text = "幻想乡 · 初代家园"
    title_label.add_theme_font_size_override("font_size", 23)
    title_label.add_theme_color_override("font_color", Color("#fff5db"))
    header.add_child(title_label)

    subtitle_label = Label.new()
    subtitle_label.text = "仅演示行动事件 · 尚未连接真实 AI"
    subtitle_label.add_theme_font_size_override("font_size", 13)
    subtitle_label.add_theme_color_override("font_color", Color("#e4e6ca"))
    header.add_child(subtitle_label)

    controls = HBoxContainer.new()
    controls.name = "TouchControls"
    controls.set_anchors_and_offsets_preset(Control.PRESET_TOP_LEFT)
    controls.add_theme_constant_override("separation", 8)
    add_child(controls)

    day_button = _make_time_button("MorningButton", "上午", false)
    dusk_button = _make_time_button("DuskButton", "黄昏", true)
    controls.add_child(day_button)
    controls.add_child(dusk_button)

    resident_status_label = Label.new()
    resident_status_label.name = "PublicResidentStatus"
    resident_status_label.add_theme_font_size_override("font_size", 13)
    resident_status_label.add_theme_color_override("font_color", Color("#fff5df"))
    resident_status_label.add_theme_color_override("font_shadow_color", Color("#1a3330"))
    resident_status_label.add_theme_constant_override("shadow_offset_y", 2)
    add_child(resident_status_label)

    status_label = Label.new()
    status_label.name = "Status"
    status_label.add_theme_font_size_override("font_size", 14)
    status_label.add_theme_color_override("font_color", Color("#fff5db"))
    status_label.add_theme_color_override("font_shadow_color", Color("#132526"))
    status_label.add_theme_constant_override("shadow_offset_x", 1)
    status_label.add_theme_constant_override("shadow_offset_y", 2)
    add_child(status_label)

    hint_label = Label.new()
    hint_label.name = "TouchHint"
    hint_label.text = "左右滑动观察家园（不能控制居民）"
    hint_label.add_theme_font_size_override("font_size", 14)
    hint_label.add_theme_color_override("font_color", Color("#f5ebcf"))
    hint_label.add_theme_color_override("font_shadow_color", Color("#132526"))
    hint_label.add_theme_constant_override("shadow_offset_y", 2)
    add_child(hint_label)

func _refresh_layout() -> void:
    _apply_layout(size)

func _apply_layout(view: Vector2) -> void:
    if scenery == null or view.x <= 1.0 or view.y <= 1.0:
        return
    # Godot's expanded canvas uses virtual units. Compute a physical-pixel
    # conversion so phone tap targets never shrink with the base resolution.
    var physical_height := float(get_window().size.y)
    # Headless Godot exposes a tiny dummy window. Use logical test dimensions
    # rather than interpreting that dummy size as a phone's real pixel count.
    if physical_height < 240.0:
        physical_height = view.y
    var logical_per_pixel := view.y / physical_height
    var margin := 18.0 * logical_per_pixel
    is_portrait = view.y > view.x * 1.15
    var narrow := view.x < 700.0 * logical_per_pixel

    # At least 52 physical pixels tall and about 130px wide per action.
    var btn_width := minf((view.x - margin * 2.0 - 8.0) * 0.5, clampf(130.0 * logical_per_pixel, 120.0, 210.0))
    var btn_height := maxf(58.0, 52.0 * logical_per_pixel)
    day_button.add_theme_font_size_override("font_size", int(round(18.0 * logical_per_pixel)))
    dusk_button.add_theme_font_size_override("font_size", int(round(18.0 * logical_per_pixel)))
    status_label.add_theme_font_size_override("font_size", int(round(16.0 * logical_per_pixel)))
    hint_label.add_theme_font_size_override("font_size", int(round(14.0 * logical_per_pixel)))
    day_button.custom_minimum_size = Vector2(btn_width, btn_height)
    dusk_button.custom_minimum_size = Vector2(btn_width, btn_height)
    var buttons_width := btn_width * 2.0 + 8.0
    controls.size = Vector2(buttons_width, btn_height)

    if is_portrait:
        controls.position = Vector2((view.x - buttons_width) * 0.5, view.y - btn_height - 22.0 * logical_per_pixel)
        title_panel.position = Vector2(margin, 14.0 * logical_per_pixel)
        title_panel.size = Vector2(view.x - margin * 2.0, 74.0 * logical_per_pixel)
        title_label.add_theme_font_size_override("font_size", int(round(20.0 * logical_per_pixel)))
        subtitle_label.add_theme_font_size_override("font_size", int(round(12.0 * logical_per_pixel)))
        status_label.position = Vector2(margin, controls.position.y - 48.0 * logical_per_pixel)
        hint_label.visible = true
        hint_label.position = Vector2(margin, controls.position.y - 84.0 * logical_per_pixel)
        resident_status_label.position = Vector2(margin, 104.0 * logical_per_pixel)

        # Portrait = a draggable panorama, preserving aspect and readable detail.
        var available_height := maxf(160.0, view.y - 170.0 * logical_per_pixel)
        var scale_factor := available_height / ART_SIZE.y
        var render_size := ART_SIZE * scale_factor
        scene_width = render_size.x
        scenery.size = render_size
        _position_scenery(view)
    else:
        controls.position = Vector2(view.x - buttons_width - margin, view.y - btn_height - margin)
        title_panel.position = Vector2(margin, 14.0 * logical_per_pixel)
        title_panel.size = Vector2(minf(340.0 * logical_per_pixel, view.x - margin * 2.0), 74.0 * logical_per_pixel)
        title_label.add_theme_font_size_override("font_size", int(round(23.0 * logical_per_pixel)))
        subtitle_label.add_theme_font_size_override("font_size", int(round(13.0 * logical_per_pixel)))
        status_label.position = Vector2(margin, view.y - 31.0 * logical_per_pixel)
        hint_label.visible = false
        resident_status_label.position = Vector2(margin, view.y - 106.0 * logical_per_pixel)
        # Landscape and desktop keep the entire scene visible.
        var scale_factor := minf(view.x / ART_SIZE.x, view.y / ART_SIZE.y)
        var render_size := ART_SIZE * scale_factor
        scene_width = render_size.x
        scenery.size = render_size
        pan_x = 0.0
        _position_scenery(view)

    resident_status_label.size = Vector2(maxf(80.0, view.x - margin * 2.0), 62.0 * logical_per_pixel)
    resident_status_label.add_theme_font_size_override("font_size", int(round(13.0 * logical_per_pixel)))
    # UI layout is checked against the viewport size in tests on both shapes.
    if narrow:
        title_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE

func _position_scenery(view: Vector2) -> void:
    var half_overflow := maxf(0.0, (scene_width - view.x) * 0.5)
    pan_x = clampf(pan_x, -half_overflow, half_overflow)
    scenery.position = Vector2(
        (view.x - scenery.size.x) * 0.5 + pan_x,
        (view.y - scenery.size.y) * 0.5
    )
    terrain.position = scenery.position
    terrain.size = scenery.size
    if resident_layer != null:
        resident_layer.position = scenery.position
        resident_layer.scale = scenery.size / ART_SIZE

func _gui_input(event: InputEvent) -> void:
    if not is_portrait:
        return
    if event is InputEventScreenDrag:
        pan_x += event.relative.x
        _position_scenery(size)
        accept_event()
    elif event is InputEventMouseMotion and Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT):
        pan_x += event.relative.x
        _position_scenery(size)
        accept_event()

func _set_time(dusk: bool) -> void:
    is_dusk = dusk
    scenery.texture = DUSK_SCENE if dusk else DAY_SCENE
    terrain.texture = terrain_dusk if dusk else terrain_day
    day_button.button_pressed = not dusk
    dusk_button.button_pressed = dusk
    # Viewer lighting is a view-only setting. It cannot trigger any resident action.
    status_label.text = "观察光照：黄昏" if dusk else "观察光照：上午"
    print("FIRST_HOME_READY time=", "dusk" if dusk else "morning")

func _unhandled_key_input(event: InputEvent) -> void:
    if event is InputEventKey and event.pressed and not event.echo:
        if event.keycode == KEY_1:
            _set_time(false)
        elif event.keycode == KEY_2:
            _set_time(true)
        elif event.keycode == KEY_T or event.keycode == KEY_SPACE:
            _set_time(not is_dusk)
        else:
            return
        get_viewport().set_input_as_handled()
