@@ -0,0 +1,110 @@
+class_name FvBindingBar
+extends Control
+const AppState = preload("res://scripts/state/app_state.gd")
+## Top bar from the 002 sketch: model portrait, presence + model UUID, and the
+## number of models in the community. Values come from AppState only.
+
+const Avatar = preload("res://scripts/ui/avatar.gd")
+const INK := Color("22201d")
+const MUTED := Color("6f6a63")
+const PAPER := Color("fbfaf6")
+const ONLINE := Color("4f7d5c")
+const AWAY := Color("a0713a")
+
+var state: AppState = null
+var portrait: Control
+var name_label: Label
+var status_label: Label
+var uuid_label: Label
+var count_label: Label
+var model_color := Color("84aeda")
+var _built := false
+
+
+func setup(app_state: AppState) -> void:
+	state = app_state
+	if _built:
+		refresh()
+
+
+func _ready() -> void:
+	mouse_filter = Control.MOUSE_FILTER_IGNORE
+	_build()
+	_built = true
+	refresh()
+	resized.connect(_layout)
+
+
+func _build() -> void:
+	var panel := Panel.new()
+	panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	panel.add_theme_stylebox_override("panel", _paper_box())
+	panel.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	add_child(panel)
+
+	portrait = Avatar.new()
+	portrait.custom_minimum_size = Vector2(42, 42)
+	portrait.tint = model_color
+	add_child(portrait)
+
+	name_label = _label(self, "", 18, INK)
+	status_label = _label(self, "", 12, ONLINE)
+	uuid_label = _label(self, "", 10, MUTED)
+	count_label = _label(self, "", 12, MUTED)
+	count_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
+
+
+func _layout() -> void:
+	if not _built or size.x < 20.0:
+		return
+	portrait.position = Vector2(12, 14)
+	portrait.size = Vector2(42, 42)
+	name_label.position = Vector2(66, 6)
+	name_label.size = Vector2(maxf(80, size.x - 220), 26)
+	status_label.position = Vector2(66, 31)
+	status_label.size = Vector2(96, 18)
+	uuid_label.position = Vector2(66, 50)
+	uuid_label.size = Vector2(maxf(80, size.x - 190), 16)
+	count_label.position = Vector2(size.x - 146, 8)
+	count_label.size = Vector2(134, 18)
+
+
+func refresh() -> void:
+	if not _built or state == null or not state.has_identity():
+		return
+	var resident := state.bound_resident
+	name_label.text = resident.display_name
+	status_label.text = "● " + resident.status_label()
+	status_label.add_theme_color_override("font_color",
+		ONLINE if resident.status == "online" else (AWAY if resident.status == "away" else MUTED))
+	uuid_label.text = "模型 UUID  " + AppState.short_uuid(resident.model.model_uuid)
+	count_label.text = "社区内模型 %d" % state.model_count()
+
+
+func set_model_color(color: Color) -> void:
+	model_color = color
+	if portrait != null:
+		portrait.tint = model_color
+		portrait.queue_redraw()
+
+
+func _paper_box() -> StyleBoxFlat:
+	var box := StyleBoxFlat.new()
+	box.bg_color = PAPER
+	box.border_color = INK
+	box.set_border_width_all(2)
+	box.set_corner_radius_all(10)
+	box.shadow_color = Color(0.1, 0.09, 0.08, 0.07)
+	box.shadow_size = 3
+	box.shadow_offset = Vector2(1, 2)
+	return box
+
+
+func _label(parent: Node, text_value: String, font_size: int, color: Color) -> Label:
+	var label := Label.new()
+	label.text = text_value
+	label.add_theme_font_size_override("font_size", font_size)
+	label.add_theme_color_override("font_color", color)
+	label.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	parent.add_child(label)
+	return label
diff --git a/fantasy-village-002/scripts/ui/community_screen.gd b/fantasy-village-002/scripts/ui/community_screen.gd
new file mode 100644
index 0000000..22613b4
--- /dev/null
+++ b/fantasy-village-002/scripts/ui/community_screen.gd
@@ -0,0 +1,233 @@
+class_name FvCommunityScreen
+extends Control
+## 002 community screen from the second sketch:
+## top binding bar -> community map -> world channel -> owner dock.
+## Placeholder art and local mock services only; no real model connection.
+
+const WorldScript = preload("res://scripts/world/community_world.gd")
+const BindingBar = preload("res://scripts/ui/binding_bar.gd")
+const WorldChannel = preload("res://scripts/ui/world_channel.gd")
+const OwnerDock = preload("res://scripts/ui/owner_dock.gd")
+const AppState = preload("res://scripts/state/app_state.gd")
+const MockService = preload("res://scripts/services/mock_community_service.gd")
+
+const INK := Color("22201d")
+const MUTED := Color("6f6a63")
+const PAPER := Color("fbfaf6")
+const MAP_FILL := Color("e4edd8")
+const PAD_NARROW := 12.0
+const PAD_WIDE := 20.0
+const TOPBAR_H := 72.0
+const TOPBAR_H_WIDE := 68.0
+const DOCK_H := 204.0
+const DOCK_H_WIDE := 190.0
+const CHANNEL_H := 106.0
+const RIGHT_COL_W := 360.0
+const GAP := 8.0
+const MATERIALS := [
+	Color("84aeda"),
+	Color("8fbf9a"),
+	Color("d9a36f"),
+	Color("b59bcf"),
+]
+
+var state: AppState = null
+var top_bar: BindingBar
+var map_panel: Panel
+var map_clip: Control
+var world: Node2D
+var track_button: Button
+var channel: WorldChannel
+var dock: OwnerDock
+var _private_history: Array[String] = []
+var _material_index := 0
+var _built := false
+
+
+func setup(app_state: AppState) -> void:
+	state = app_state
+
+
+func _ready() -> void:
+	mouse_filter = Control.MOUSE_FILTER_IGNORE
+	_build()
+	_built = true
+	_layout()
+	world.entity_selected.connect(_on_entity_selected)
+	world.resident_status_changed.connect(_on_world_status)
+	world.select_resident("ai_1")
+	_private_history = [state.bound_resident.display_name + "：你回来啦，我刚好在广场。"]
+	dock.set_history(_private_history)
+	var bound_agent = world.get_resident_by_uuid(state.bound_resident.uuid)
+	if bound_agent != null:
+		top_bar.set_model_color(bound_agent.color)
+
+
+func _notification(what: int) -> void:
+	if what == NOTIFICATION_RESIZED and _built:
+		_layout()
+
+
+func _build() -> void:
+	var background := ColorRect.new()
+	background.color = Color("efeeea")
+	background.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	background.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	add_child(background)
+
+	map_panel = Panel.new()
+	map_panel.name = "MapPanel"
+	map_panel.add_theme_stylebox_override("panel", _map_box())
+	map_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	add_child(map_panel)
+	map_clip = Control.new()
+	map_clip.name = "MapClip"
+	map_clip.clip_contents = true
+	map_clip.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	map_panel.add_child(map_clip)
+
+	world = WorldScript.new()
+	world.name = "CommunityWorld"
+	world.apply_identity(state)
+	world.font = theme.default_font if theme != null else null
+	map_clip.add_child(world)
+
+	track_button = Button.new()
+	track_button.name = "TrackButton"
+	track_button.text = "模型出门了 · 点击追踪位置"
+	track_button.add_theme_font_size_override("font_size", 12)
+	track_button.visible = false
+	track_button.pressed.connect(_on_track)
+	map_panel.add_child(track_button)
+
+	top_bar = BindingBar.new()
+	top_bar.name = "BindingBar"
+	top_bar.setup(state)
+	add_child(top_bar)
+
+	channel = WorldChannel.new()
+	channel.name = "WorldChannel"
+	channel.set_messages(MockService.world_messages(state))
+	add_child(channel)
+
+	dock = OwnerDock.new()
+	dock.name = "OwnerDock"
+	dock.setup(state)
+	dock.message_sent.connect(_on_private_message)
+	dock.workshop_requested.connect(_on_workshop)
+	dock.material_requested.connect(_on_material)
+	add_child(dock)
+
+
+func _layout() -> void:
+	if not _built:
+		return
+	var view := size
+	if view.x <= 0.0 or view.y <= 0.0:
+		view = get_viewport_rect().size
+	var narrow := view.x < 760.0
+	if narrow:
+		_place(top_bar, PAD_NARROW, 12, view.x - PAD_NARROW * 2.0, TOPBAR_H)
+		_place(dock, PAD_NARROW, view.y - 12.0 - DOCK_H,
+			view.x - PAD_NARROW * 2.0, DOCK_H)
+		_place(channel, PAD_NARROW, dock.position.y - GAP - CHANNEL_H,
+			view.x - PAD_NARROW * 2.0, CHANNEL_H)
+		_place(map_panel, PAD_NARROW, top_bar.position.y + top_bar.size.y + GAP,
+			view.x - PAD_NARROW * 2.0,
+			channel.position.y - GAP - (top_bar.position.y + top_bar.size.y + GAP))
+	else:
+		_place(top_bar, PAD_WIDE, 12, view.x - PAD_WIDE * 2.0, TOPBAR_H_WIDE)
+		var body_top := top_bar.position.y + top_bar.size.y + 10.0
+		var body_bottom := view.y - 12.0
+		var right_x := view.x - PAD_WIDE - RIGHT_COL_W
+		_place(map_panel, PAD_WIDE, body_top,
+			right_x - GAP - PAD_WIDE, body_bottom - body_top)
+		_place(dock, right_x, body_bottom - DOCK_H_WIDE, RIGHT_COL_W, DOCK_H_WIDE)
+		_place(channel, right_x, body_top, RIGHT_COL_W,
+			dock.position.y - GAP - body_top)
+	_place(map_clip, 6, 6, map_panel.size.x - 12, map_panel.size.y - 12)
+	var scale_value := minf(map_clip.size.x / 960.0, map_clip.size.y / 540.0)
+	world.scale = Vector2.ONE * scale_value
+	world.position = (map_clip.size - Vector2(960, 540) * scale_value) / 2.0
+	track_button.position = Vector2(maxf(8.0, (map_panel.size.x - 232.0) / 2.0),
+		map_panel.size.y - 50.0)
+	track_button.size = Vector2(232, 40)
+
+
+func _place(control: Control, x: float, y: float, width: float, height: float) -> void:
+	control.position = Vector2(x, y)
+	control.size = Vector2(maxf(40.0, width), maxf(40.0, height))
+
+
+func _on_entity_selected(info: Dictionary) -> void:
+	if str(info.get("kind", "")) != "resident":
+		dock.show_notice("查看：" + str(info.get("name", "场景物品")))
+		return
+	dock.set_selected(info)
+	dock.set_history(_private_history)
+
+
+func _on_world_status() -> void:
+	if dock == null or not _built:
+		return
+	var info: Dictionary = world.get_selected_info()
+	if str(info.get("kind", "")) == "resident":
+		dock.set_selected(info)
+
+
+func _on_private_message(text: String) -> void:
+	if state == null or state.bound_resident == null:
+		return
+	_private_history.append("我：" + text)
+	var reply := MockService.private_reply(text, state.bound_resident)
+	_private_history.append(state.bound_resident.display_name + "：" + reply)
+	while _private_history.size() > 8:
+		_private_history.pop_front()
+	dock.set_history(_private_history)
+	dock.show_notice("本地占位回复")
+
+
+func _on_workshop() -> void:
+	dock.show_notice("创意工坊 003 开放")
+
+
+func _on_material() -> void:
+	_material_index = (_material_index + 1) % MATERIALS.size()
+	var color: Color = MATERIALS[_material_index]
+	var resident = world.get_resident_by_uuid(state.bound_resident.uuid)
+	if resident != null:
+		resident.color = color
+		world.queue_redraw()
+	if top_bar != null:
+		top_bar.set_model_color(color)
+	dock.show_notice("材质已同步，UUID 不变")
+
+
+func _on_track() -> void:
+	dock.show_notice("追踪请求已记录（占位）")
+
+
+func set_bound_presence(status: String) -> void:
+	if state == null or not state.has_identity():
+		return
+	state.bound_resident.status = status
+	world.set_resident_status("ai_1", status)
+	track_button.visible = status == "away"
+	top_bar.refresh()
+	var info: Dictionary = world.get_selected_info()
+	if str(info.get("kind", "")) == "resident":
+		dock.set_selected(info)
+
+
+func _unhandled_key_input(event: InputEvent) -> void:
+	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_F9:
+		set_bound_presence("online" if state.bound_resident.status == "away" else "away")
+
+
+func _map_box() -> StyleBoxFlat:
+	var box := StyleBoxFlat.new()
+	box.bg_color = MAP_FILL
+	box.border_color = INK
+	box.set_border_width_all(2)
+	box.set_corner_radius_all(10)
+	return box
diff --git a/fantasy-village-002/scripts/ui/login_screen.gd b/fantasy-village-002/scripts/ui/login_screen.gd
new file mode 100644
index 0000000..f5ee96d
--- /dev/null
+++ b/fantasy-village-002/scripts/ui/login_screen.gd
@@ -0,0 +1,247 @@
+class_name FvLoginScreen
+extends Control
+const AppState = preload("res://scripts/state/app_state.gd")
+## 002 login screen. It creates or reuses the local identity and never talks to
+## an account server. The paper/sketch styling is placeholder art.
+
+signal submitted(display_name: String, create_new: bool)
+
+const Avatar = preload("res://scripts/ui/avatar.gd")
+const SketchFrame = preload("res://scripts/ui/sketch_frame.gd")
+const INK := Color("22201d")
+const MUTED := Color("6f6a63")
+const PAPER := Color("fbfaf6")
+const BACKGROUND := Color("efeeea")
+const ACCENT := Color("6f5a8f")
+const ONLINE := Color("4f7d5c")
+const ERROR := Color("a4443f")
+
+var state: AppState = null
+var account_input: LineEdit
+var primary_button: Button
+var secondary_button: Button
+var error_label: Label
+var model_name: Label
+var model_status: Label
+var model_uuid: Label
+var portrait: Control
+var column: VBoxContainer
+var is_new := true
+var _built := false
+
+
+func setup(app_state: AppState) -> void:
+	state = app_state
+	if _built:
+		_refresh()
+
+
+func _ready() -> void:
+	mouse_filter = Control.MOUSE_FILTER_IGNORE
+	_build()
+	_built = true
+	_refresh()
+
+
+func _notification(what: int) -> void:
+	if what == NOTIFICATION_RESIZED and _built:
+		_update_width()
+
+
+func _build() -> void:
+	var background := ColorRect.new()
+	background.color = BACKGROUND
+	background.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	background.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	add_child(background)
+
+	var scroll := ScrollContainer.new()
+	scroll.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
+	scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
+	scroll.follow_focus = true
+	add_child(scroll)
+
+	var center := CenterContainer.new()
+	center.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	center.size_flags_vertical = Control.SIZE_EXPAND_FILL
+	scroll.add_child(center)
+
+	column = VBoxContainer.new()
+	column.add_theme_constant_override("separation", 14)
+	center.add_child(column)
+
+	var title_frame := SketchFrame.new()
+	title_frame.custom_minimum_size = Vector2(0, 148)
+	column.add_child(title_frame)
+	var title := _label(title_frame, "幻想乡", 46, INK)
+	title.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	title.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
+
+	var subtitle := _label(column, "AI 的交流社区", 17, MUTED)
+	subtitle.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+
+	var card := PanelContainer.new()
+	card.add_theme_stylebox_override("panel", _paper_box())
+	column.add_child(card)
+	var margin := MarginContainer.new()
+	for side in ["left", "right", "top", "bottom"]:
+		margin.add_theme_constant_override("margin_" + side, 22 if side != "top" else 18)
+	card.add_child(margin)
+	var body := VBoxContainer.new()
+	body.add_theme_constant_override("separation", 9)
+	margin.add_child(body)
+
+	_label(body, "以主人身份进入", 13, MUTED)
+	_label(body, "账号名称", 13, INK)
+	account_input = LineEdit.new()
+	account_input.placeholder_text = "输入你的名字"
+	account_input.max_length = 12
+	account_input.custom_minimum_size = Vector2(0, 46)
+	account_input.add_theme_font_size_override("font_size", 17)
+	account_input.text_changed.connect(_on_text_changed)
+	account_input.text_submitted.connect(func(_text: String) -> void: _submit())
+	body.add_child(account_input)
+
+	var preview := HBoxContainer.new()
+	preview.add_theme_constant_override("separation", 12)
+	body.add_child(preview)
+	portrait = Avatar.new()
+	portrait.custom_minimum_size = Vector2(46, 46)
+	portrait.size_flags_vertical = Control.SIZE_SHRINK_CENTER
+	portrait.tint = Color("84aeda")
+	preview.add_child(portrait)
+	var preview_text := VBoxContainer.new()
+	preview_text.add_theme_constant_override("separation", 1)
+	preview_text.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	preview.add_child(preview_text)
+	model_name = _label(preview_text, "小晴", 17, INK)
+	model_status = _label(preview_text, "在线", 12, ONLINE)
+	model_uuid = _label(preview_text, "", 11, MUTED)
+	model_uuid.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+
+	var divider := ColorRect.new()
+	divider.color = Color("ddd8ce")
+	divider.custom_minimum_size = Vector2(0, 1)
+	body.add_child(divider)
+
+	primary_button = Button.new()
+	primary_button.text = "进入幻想乡"
+	primary_button.custom_minimum_size = Vector2(0, 46)
+	primary_button.add_theme_font_size_override("font_size", 17)
+	primary_button.pressed.connect(_submit)
+	body.add_child(primary_button)
+
+	secondary_button = Button.new()
+	secondary_button.text = "随机一个名字"
+	secondary_button.custom_minimum_size = Vector2(0, 36)
+	secondary_button.add_theme_font_size_override("font_size", 14)
+	secondary_button.pressed.connect(_random_name)
+	body.add_child(secondary_button)
+
+	error_label = _label(body, "", 12, ERROR)
+	error_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	error_label.visible = false
+
+	_label(body, "一个账号 · 一块土地 · 一个绑定模型", 12, MUTED).horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	_label(body, "当前为本地模拟，尚未连接真实模型", 11, MUTED).horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+
+	var footer := _label(column, "002 · 登录页界面原型", 11, MUTED)
+	footer.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+
+	_update_width()
+
+
+func _update_width() -> void:
+	if column == null:
+		return
+	var available := size.x - 40.0
+	if available <= 0.0:
+		available = 420.0
+	column.custom_minimum_size.x = clampf(available, 320.0, 440.0)
+
+
+func _refresh() -> void:
+	if state == null or account_input == null:
+		return
+	is_new = not state.has_identity()
+	primary_button.disabled = true
+	error_label.visible = false
+	if is_new:
+		account_input.text = ""
+		primary_button.text = "进入幻想乡"
+		secondary_button.visible = true
+		model_name.text = "首次进入将绑定「小晴」"
+		model_status.text = "本地占位模型"
+		model_status.add_theme_color_override("font_color", MUTED)
+		model_uuid.text = "创建后生成居民 UUID 与模型 UUID"
+		portrait.tint = Color("84aeda")
+	else:
+		account_input.text = state.account.display_name
+		primary_button.text = "回到幻想乡"
+		primary_button.disabled = false
+		secondary_button.visible = false
+		var resident := state.bound_resident
+		model_name.text = resident.display_name
+		model_status.text = resident.status_label() + " · 本地占位模型"
+		model_status.add_theme_color_override("font_color",
+			ONLINE if resident.status == "online" else MUTED)
+		model_uuid.text = "模型 UUID " + state.short_uuid(resident.model.model_uuid)
+		portrait.tint = Color("84aeda")
+	portrait.queue_redraw()
+
+
+func _on_text_changed(new_text: String) -> void:
+	if primary_button == null:
+		return
+	primary_button.disabled = new_text.strip_edges().is_empty()
+	if error_label != null:
+		error_label.visible = false
+
+
+func _random_name() -> void:
+	var names := ["林间", "小雨", "阿青", "南枝"]
+	account_input.text = names[randi() % names.size()]
+	account_input.caret_column = account_input.text.length()
+	primary_button.disabled = false
+	account_input.grab_focus()
+
+
+func _submit() -> void:
+	var cleaned := account_input.text.strip_edges()
+	if cleaned.is_empty():
+		_show_error("请输入账号名称。")
+		return
+	if cleaned.length() > 12:
+		_show_error("账号名称最多 12 个字。")
+		return
+	error_label.visible = false
+	submitted.emit(cleaned, is_new)
+
+
+func _show_error(message: String) -> void:
+	error_label.text = message
+	error_label.visible = true
+
+
+func _paper_box() -> StyleBoxFlat:
+	var box := StyleBoxFlat.new()
+	box.bg_color = PAPER
+	box.border_color = INK
+	box.set_border_width_all(2)
+	box.set_corner_radius_all(10)
+	box.shadow_color = Color(0.1, 0.09, 0.08, 0.08)
+	box.shadow_size = 4
+	box.shadow_offset = Vector2(2, 3)
+	return box
+
+
+func _label(parent: Node, text_value: String, font_size: int, color: Color) -> Label:
+	var label := Label.new()
+	label.text = text_value
+	label.add_theme_font_size_override("font_size", font_size)
+	label.add_theme_color_override("font_color", color)
+	label.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	parent.add_child(label)
+	return label
