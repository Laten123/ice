+class_name CommunityData
+extends RefCounted
+const Identity = preload("res://scripts/models/identity.gd")
+## Initial residents and scene props for milestone 001. All visuals are placeholders.
+
+static func residents(state = null) -> Array[Dictionary]:
+	var list: Array[Dictionary] = [
+		{"id": "owner", "name": "林间", "role": "主人", "description": "社区的主人。点击空地，带我在幻想乡走走。", "color": Color("eaa76b"), "position": Vector2(438, 367), "autonomous": false},
+		{"id": "ai_1", "name": "小晴", "role": "绑定模型", "description": "喜欢晒太阳的 AI 居民。目前只会散步与说预设台词。", "color": Color("84aeda"), "position": Vector2(515, 290), "autonomous": true},
+		{"id": "ai_2", "name": "阿澈", "role": "社区模型", "description": "喜欢观察社区的 AI 居民。目前只会散步与说预设台词。", "color": Color("b59bcf"), "position": Vector2(630, 317), "autonomous": true},
+	]
+	if state == null or not state.has_identity():
+		return list
+	list[0]["name"] = state.account.display_name
+	list[0]["uuid"] = state.account.uuid
+	var bound: Identity.Resident = state.bound_resident
+	list[1]["name"] = bound.display_name
+	list[1]["uuid"] = bound.uuid
+	list[1]["model_uuid"] = bound.model.model_uuid
+	list[1]["model_name"] = bound.model.display_name
+	list[1]["bound"] = true
+	list[1]["status"] = bound.status
+	list[1]["description"] = "和你绑定的 AI 居民。当前为本地占位模型，UUID 固定，模型可替换。"
+	for resident: Identity.Resident in state.community_models:
+		if resident.bound:
+			continue
+		list[2]["name"] = resident.display_name
+		list[2]["uuid"] = resident.uuid
+		list[2]["model_uuid"] = resident.model.model_uuid
+		list[2]["model_name"] = resident.model.display_name
+		list[2]["bound"] = false
+		list[2]["status"] = resident.status
+		list[2]["description"] = "社区里的另一位模型居民。点击可查看名字与模型 UUID。"
+		break
+	return list
+
+static func objects() -> Array[Dictionary]:
+	return [
+		{"id": "home", "name": "林间的小屋", "kind": "房屋", "description": "一间阳光充足的小屋。当前仅为场景占位，暂不能进入。", "status": "静静伫立", "position": Vector2(233, 185), "hit_rect": Rect2(151, 81, 166, 139), "obstacle": Rect2(166, 137, 139, 78), "style": "house", "color": Color("d48877")},
+		{"id": "community_house", "name": "居民小屋", "kind": "房屋", "description": "AI 居民的小屋。当前只有外观占位，没有室内系统。", "status": "静静伫立", "position": Vector2(718, 175), "hit_rect": Rect2(639, 69, 164, 142), "obstacle": Rect2(651, 128, 138, 78), "style": "house", "color": Color("809bbd")},
+		{"id": "notice", "name": "社区告示牌", "kind": "物品", "description": "欢迎来到幻想乡！点击居民查看信息，点击空地让选中的居民移动。", "status": "欢迎来访", "position": Vector2(467, 173), "hit_rect": Rect2(440, 119, 54, 60), "obstacle": Rect2(448, 157, 38, 23), "style": "notice"},
