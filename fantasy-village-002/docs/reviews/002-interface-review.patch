+class_name FvMockCommunityService
+extends RefCounted
+const AppState = preload("res://scripts/state/app_state.gd")
+const Identity = preload("res://scripts/models/identity.gd")
+## Deterministic local stand-in for the future world channel / model service.
+## It never performs network requests and its replies are explicitly placeholder.
+
+const TRACK_NOTICE := "追踪请求已记录。真实位置服务将在后续阶段接入。"
+const WORKSHOP_NOTICE := "创意工坊将在 003 阶段开放。"
+const MATERIAL_NOTICE := "材质已切换：只改变占位外观，居民与模型 UUID 不变。"
+
+
+static func world_messages(state: AppState) -> Array[Dictionary]:
+	return [
+		{
+			"sender": state.account.display_name,
+			"kind": "owner",
+			"text": "我刚回到社区，今天大家怎么样？",
+		},
+		{
+			"sender": state.bound_resident.display_name,
+			"kind": "model",
+			"text": "院子里很安静，我把长椅擦干净了。",
+		},
+	]
+
+
+static func private_reply(text: String, resident: Identity.Resident) -> String:
+	var replies := [
+		"收到啦，我在广场这边。",
+		"好呀，等我把手边的事做完。",
+		"嗯，我一直在这里。",
+	]
+	return replies[text.length() % replies.size()]
+
+
+static func status_label(status: String) -> String:
+	match status:
+		"online":
+			return "在线"
+		"away":
+			return "已出门"
+		"offline":
+			return "离线"
+		_:
+			return "未知"
diff --git a/fantasy-village-002/scripts/state/app_state.gd b/fantasy-village-002/scripts/state/app_state.gd
new file mode 100644
index 0000000..c8a6e48
--- /dev/null
+++ b/fantasy-village-002/scripts/state/app_state.gd
@@ -0,0 +1,190 @@
+class_name FvAppState
+extends RefCounted
+const Identity = preload("res://scripts/models/identity.gd")
+## Local-only 002 state. No account server, model service or network calls.
+##
+## Invariants enforced here:
+## - one account, one land, one bound resident;
+## - resident.uuid never changes when the model binding is replaced;
+## - community_models contains the bound resident exactly once.
+
+const SAVE_PATH := "user://fv002_profile.json"
+const SAVE_VERSION := 2
+const BOUND_NAME := "小晴"
+const NEIGHBOR_NAME := "阿澈"
+const DEFAULT_MODEL_ID := "local-fantasy-0.1"
+
+var account: Identity.Account = null
+var land: Identity.Land = null
+var bound_resident: Identity.Resident = null
+var community_models: Array = []
+var save_path := SAVE_PATH
+
+
+func has_identity() -> bool:
+	return account != null and land != null and bound_resident != null
+
+
+func create_identity(display_name: String) -> bool:
+	var cleaned := display_name.strip_edges()
+	if cleaned.is_empty() or cleaned.length() > 12:
+		return false
+	var created_at := int(Time.get_unix_time_from_system())
+	account = Identity.Account.new(_new_uuid(), cleaned, created_at)
+	bound_resident = _new_resident(BOUND_NAME, true, "online")
+	var neighbor := _new_resident(NEIGHBOR_NAME, false, "online")
+	community_models = [bound_resident, neighbor]
+	land = Identity.Land.new(
+		"land_" + _new_uuid().substr(0, 8),
+		account.uuid,
+		bound_resident.uuid,
+		cleaned + "的土地")
+	return true
+
+
+func load_identity() -> bool:
+	if not FileAccess.file_exists(save_path):
+		return false
+	var file := FileAccess.open(save_path, FileAccess.READ)
+	if file == null:
+		push_error("Cannot open 002 profile: %s" % FileAccess.get_open_error())
+		return false
+	var parsed: Variant = JSON.parse_string(file.get_as_text())
+	file.close()
+	if not (parsed is Dictionary):
+		push_error("002 profile is not a JSON object")
+		return false
+	var payload: Dictionary = parsed
+	if int(payload.get("version", 0)) != SAVE_VERSION:
+		push_error("Unsupported 002 profile version")
+		return false
+	account = Identity.account_from_dict(payload.get("account", {}))
+	land = Identity.land_from_dict(payload.get("land", {}))
+	bound_resident = Identity.resident_from_dict(payload.get("bound_resident", {}))
+	community_models.clear()
+	for entry: Variant in payload.get("community_models", []):
+		if entry is Dictionary:
+			community_models.append(Identity.resident_from_dict(entry))
+	# Keep a single source of truth: the bound resident must be the same object
+	# as the bound entry in the community list, including its model binding.
+	if bound_resident == null or bound_resident.model == null:
+		clear_identity()
+		push_warning("002 profile has no bound resident model")
+		return false
+	var matched_bound := false
+	for resident: Identity.Resident in community_models:
+		if resident.uuid == bound_resident.uuid:
+			if resident.model == null or resident.model.model_uuid != bound_resident.model.model_uuid:
+				clear_identity()
+				push_warning("002 bound resident and community entry disagree on the model")
+				return false
+			bound_resident = resident
+			matched_bound = true
+			break
+	if not matched_bound or not _is_valid():
+		clear_identity()
+		push_warning("002 profile violates the one-account/one-land/one-resident rule")
+		return false
+	return true
+
+
+func save_identity() -> bool:
+	if not _is_valid():
+		push_error("Refusing to save an invalid 002 profile")
+		return false
+	var payload := {
+		"version": SAVE_VERSION,
+		"account": account.to_dict(),
+		"land": land.to_dict(),
+		"bound_resident": bound_resident.to_dict(),
+		"community_models": [],
+	}
+	for resident: Identity.Resident in community_models:
+		payload["community_models"].append(resident.to_dict())
+	var file := FileAccess.open(save_path, FileAccess.WRITE)
+	if file == null:
+		push_error("Cannot write 002 profile: %s" % FileAccess.get_open_error())
+		return false
+	file.store_string(JSON.stringify(payload, "\t"))
+	file.close()
+	return true
+
+
+func set_model_binding(binding: Identity.ModelBinding) -> bool:
+	if bound_resident == null or binding == null:
+		return false
+	var resident_uuid := bound_resident.uuid
+	bound_resident.model = binding
+	for resident: Identity.Resident in community_models:
+		if resident.uuid == resident_uuid:
+			resident.model = binding
+	return bound_resident.uuid == resident_uuid
+
+
+func model_count() -> int:
+	return community_models.size()
+
+
+func find_model(model_uuid: String) -> Identity.Resident:
+	for resident: Identity.Resident in community_models:
+		if resident.model != null and resident.model.model_uuid == model_uuid:
+			return resident
+	return null
+
+
+func is_bound_model(model_uuid: String) -> bool:
+	return bound_resident != null and bound_resident.model != null \
+		and bound_resident.model.model_uuid == model_uuid
+
+
+func clear_identity() -> void:
+	account = null
+	land = null
+	bound_resident = null
+	community_models.clear()
+
+
+static func short_uuid(value: String) -> String:
+	if value.length() <= 13:
+		return value
+	return value.substr(0, 8) + "…" + value.substr(value.length() - 4, 4)
+
+
+func _new_resident(display_name: String, is_bound: bool, status: String) -> Identity.Resident:
+	var model := Identity.ModelBinding.new(
+		_new_uuid(), DEFAULT_MODEL_ID, display_name + " 0.1", true)
+	var resident := Identity.Resident.new(_new_uuid(), display_name, is_bound, model)
+	resident.status = status
+	return resident
+
+
+func _new_uuid() -> String:
+	var bytes := Crypto.new().generate_random_bytes(16)
+	bytes[6] = (bytes[6] & 0x0f) | 0x40
+	bytes[8] = (bytes[8] & 0x3f) | 0x80
+	var hex := bytes.hex_encode()
+	return "%s-%s-%s-%s-%s" % [
+		hex.substr(0, 8), hex.substr(8, 4), hex.substr(12, 4),
+		hex.substr(16, 4), hex.substr(20, 12)]
+
+
+func _is_valid() -> bool:
+	if account == null or land == null or bound_resident == null:
+		return false
+	if account.uuid.is_empty() or land.uuid.is_empty() or bound_resident.uuid.is_empty():
+		return false
+	if land.account_uuid != account.uuid or land.resident_uuid != bound_resident.uuid:
+		return false
+	if bound_resident.model == null or bound_resident.model.model_uuid.is_empty():
+		return false
+	var seen := {}
+	var bound_count := 0
+	for resident: Identity.Resident in community_models:
+		if resident.uuid.is_empty() or seen.has(resident.uuid):
+			return false
+		seen[resident.uuid] = true
+		if resident.bound:
+			bound_count += 1
+			if resident.uuid != bound_resident.uuid:
+				return false
+	return bound_count == 1 and seen.has(bound_resident.uuid)
diff --git a/fantasy-village-002/scripts/ui/avatar.gd b/fantasy-village-002/scripts/ui/avatar.gd
